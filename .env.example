# URL pubblico del sito (usato per canonical, sitemap, OG). In produzione: https://www.benveniaguide.it
NEXT_PUBLIC_SITE_URL=https://www.benveniaguide.it

# Google Analytics 4 — se non impostato, nessuno script di analytics viene caricato.
# Richiede comunque il consenso dell'utente (categoria "analytics").
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — codice di verifica (meta tag). Facoltativo.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Invio email del form contatti (Resend).
# Se una delle tre variabili manca: in sviluppo la richiesta viene validata ma
# nessuna email è inviata (delivery: "dev"); in produzione l'endpoint risponde 503.
# Chiave API: creala dalla dashboard Resend (API Keys) e verifica il dominio
# benveniaguide.it (record DNS) per poter usare il mittente no-reply@.
RESEND_API_KEY=
LEAD_EMAIL_FROM=Benvenia Guide <no-reply@benveniaguide.it>
LEAD_NOTIFY_EMAIL_TO=info@benveniaguide.it

# Solo per test E2E su build di produzione (`next start`): consente all'endpoint
# di rispondere delivery:"dev" invece di 503 quando mancano le variabili Resend.
# NON impostare in produzione reale.
LEAD_ALLOW_DEV_DELIVERY=
